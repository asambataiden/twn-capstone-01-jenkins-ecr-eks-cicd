@Library('twn-devops-bootcamp-jenkins-shared-library@feat/library-foundation') _

/**
 * Manually triggered ECR integration candidate — NO EKS deployment.
 * Requires a dedicated, trusted Jenkins worker with short-lived AWS identity.
 * The job must not be exposed to untrusted PRs or public build permissions.
 */
pipeline {
    agent { label 'docker-ecr-publisher' }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 40, unit: 'MINUTES')
    }
    tools {
        maven 'maven-3.9'
    }
    parameters {
        booleanParam(name: 'ALLOW_ECR_PUBLISH', defaultValue: false,
            description: 'Only enable after verifying the approved AWS test account and immutable ECR repository')
        string(name: 'AWS_ACCOUNT_ID', defaultValue: '',
            description: 'Explicit 12-digit approved AWS account ID')
        string(name: 'AWS_REGION', defaultValue: '',
            description: 'Explicit approved AWS region, e.g. eu-north-1')
        string(name: 'ECR_REPOSITORY', defaultValue: '',
            description: 'Existing approved immutable ECR repository path')
    }
    stages {
        stage('Review release target') {
            steps {
                script {
                    if (!params.ALLOW_ECR_PUBLISH) {
                        error('No publish authorization: ALLOW_ECR_PUBLISH must be explicitly enabled')
                    }
                    if (!(params.AWS_ACCOUNT_ID ==~ /[0-9]{12}/)) {
                        error('AWS_ACCOUNT_ID must contain exactly 12 digits')
                    }
                    if (!(params.AWS_REGION ==~ /[a-z]{2}(?:-[a-z]+)+-[0-9]+/)) {
                        error('AWS_REGION has invalid format')
                    }
                    if (!(params.ECR_REPOSITORY ==~ /[a-z0-9]+(?:[._\/-][a-z0-9]+)*/)) {
                        error('ECR_REPOSITORY has invalid format')
                    }
                    echo "Publishing target: ${params.AWS_ACCOUNT_ID} / ${params.AWS_REGION} / ${params.ECR_REPOSITORY}"
                }
                input message: 'Confirm approved sandbox ECR publishing target and short-lived AWS credentials?',
                      ok: 'Approve ECR publication'
            }
        }
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    String revision = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    if (!(revision ==~ /[0-9a-f]{40}/)) {
                        error('Cannot determine full source Git commit SHA')
                    }
                    env.IMAGE_TAG = "git-${revision}"
                    echo "Building approved commit: ${revision}"
                }
            }
        }
        stage('Maven verify and package') {
            steps {
                mavenVerify()
                mavenBuild(skipTests: true)
            }
        }
        stage('Build image for ECR') {
            steps {
                script {
                    env.IMAGE_REFERENCE = ecrBuild(
                        accountId: params.AWS_ACCOUNT_ID,
                        region: params.AWS_REGION,
                        repository: params.ECR_REPOSITORY,
                        tag: env.IMAGE_TAG
                    )
                }
            }
        }
        stage('Publish immutable image') {
            steps {
                script {
                    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-twn-capstone01-ecr-publisher']]) {
                        ecrPush(
                        accountId: params.AWS_ACCOUNT_ID,
                        region: params.AWS_REGION,
                        repository: params.ECR_REPOSITORY,
                        tag: env.IMAGE_TAG
                        )
                    }
                }
            }
        }
        stage('Resolve registry digest') {
            steps {
                script {
                    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-twn-capstone01-ecr-publisher']]) {
                    String digestRef = ecrImageDigest(
                        accountId: params.AWS_ACCOUNT_ID,
                        region: params.AWS_REGION,
                        repository: params.ECR_REPOSITORY,
                        tag: env.IMAGE_TAG
                    )
                    echo "Published immutable image reference: ${digestRef}"
                    writeFile file: 'ecr-image-reference.txt', text: digestRef + '\n'
                    archiveArtifacts artifacts: 'ecr-image-reference.txt',
                        allowEmptyArchive: false, fingerprint: true
                    }
                }
            }
        }
    }
    post {
        always {
            echo "ECR integration candidate finished: ${currentBuild.currentResult}"
        }
    }
}
